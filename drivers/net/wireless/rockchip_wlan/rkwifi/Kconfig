config AP6XXX
	tristate "ap6xxx wireless cards support"
	depends on RFKILL_RK
	select CFG80211
	select MAC80211
	help
	  This module adds support for wireless adapters based on
	  Broadcom ap6xxx chipset.

	  This driver uses the kernel's wireless extensions subsystem.

	  If you choose to build a module, it'll be called dhd. Say M if
	  unsure.

choice
	prompt "Enable Chip Interface"
	depends on BCMDHD
	default BCMDHD_SDIO
	help
	  Enable Chip Interface.

config BCMDHD_SDIO
	bool "SDIO bus interface support"
	depends on BCMDHD && MMC

config BCMDHD_PCIE
	bool "PCIe bus interface support"
	depends on BCMDHD && PCI

endchoice

config BCMDHD_DEBUG
	bool "Enable bcmdhd debug support"
	depends on BCMDHD
	default y
	help
	  Enable the base DHD_DEBUG code paths in the Broadcom bcmdhd driver.

config BCMDHD_DEBUG2
	bool "Enable extended bcmdhd debug support"
	depends on BCMDHD_DEBUG
	default n
	help
	  Enable extra log dump and assertion tracing paths in bcmdhd.

config BCMDHD_PLATFORM
	bool "Enable bcmdhd platform data support"
	depends on BCMDHD
	default y
	help
	  Enable Rockchip platform GPIO/power integration for bcmdhd.

config BCMDHD_DTS
	bool "Enable bcmdhd device tree GPIO parsing"
	depends on BCMDHD_PLATFORM
	default y
	help
	  Read WL_REG_ON and WL_HOST_WAKE GPIOs from the bcmdhd device tree node.

config BCMDHD_OOB_INTR
	bool "Enable bcmdhd out-of-band interrupt"
	depends on BCMDHD && BCMDHD_SDIO
	default y
	help
	  Use WL_HOST_WAKE as the bcmdhd SDIO out-of-band interrupt.

config BCMDHD_LOGDUMP
	bool "Enable bcmdhd log dump support"
	depends on BCMDHD
	default y

config BCMDHD_STATIC_BUF
	bool "Enable bcmdhd static buffer support"
	depends on BCMDHD
	default y

config BCMDHD_STATIC_BUF_IN_DHD
	bool "Allocate bcmdhd static buffers in driver"
	depends on BCMDHD_STATIC_BUF
	default y

config BCMDHD_HS_OFFLOAD
	bool "Enable bcmdhd WPA/SAE/OWE handshake offload"
	depends on BCMDHD
	default n
	help
	  Enable dongle handshake offload paths in bcmdhd. Leave this off
	  unless the cfg80211 backports required by this driver are present.

config BCMDHD_HS_BKPORT
	bool "Enable bcmdhd handshake offload backports"
	depends on BCMDHD_HS_OFFLOAD
	default n

config PCIEASPM_ROCKCHIP_WIFI_EXTENSION
	bool "Extend ASPM function"
	depends on BCMDHD_PCIE && PCIEASPM_EXT
	help
	  This enables the extensions APIs for ASPM control.

config BCMDHD_FW_PATH
	depends on BCMDHD
	string "Firmware path"
	default "/vendor/etc/firmware/fw_bcmdhd.bin"
	help
	  Path to the firmware file.

config BCMDHD_NVRAM_PATH
	depends on BCMDHD
	string "NVRAM path"
	default "/vendor/etc/firmware/nvram.txt"
	help
	  Path to the calibration file.a

config BCMDHD_STATIC_IF
	bool "Enable wlan1 support"
	help
	  default to add wlan1 interface
